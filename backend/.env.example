# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string (Supabase / Neon). Plain postgresql:// or
# postgres:// is fine — the app rewrites it to postgresql+asyncpg://.
# Percent-encode special chars in the password (@ -> %40, : -> %3A, ...).
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# JWT signing. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# IANA timezone that defines "today" for recurring-task generation and stats.
TIMEZONE=Asia/Kolkata

# Comma-separated CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENVIRONMENT=development
